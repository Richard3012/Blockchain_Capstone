{
  "name": "blockerp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-everything.ps1",
    "dev": "vite",
    "server": "node backend/src/server.js",
    "server:dev": "node --watch backend/src/server.js",
    "seed:backend": "node backend/src/scripts/seed.js",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "hardhat compile --config hardhat.config.cjs",
    "deploy": "hardhat run scripts/deploy.cjs --config hardhat.config.cjs",
    "deploy:anchor": "hardhat run scripts/deploy-record-anchor.cjs --config hardhat.config.cjs",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost --config hardhat.config.cjs",
    "deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia --config hardhat.config.cjs",
    "deploy:mumbai": "hardhat run scripts/deploy.cjs --network mumbai --config hardhat.config.cjs",
    "node": "hardhat node --config hardhat.config.cjs",
    "test": "hardhat test --config hardhat.config.cjs",
    "test:integration": "node test/integration.test.mjs",
    "test:coverage": "hardhat coverage --config hardhat.config.cjs",
    "clean": "hardhat clean --config hardhat.config.cjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.8.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.0",
    "mammoth": "^1.12.0",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^8.13.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0",
    "postcss": "^8.4.27",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.3.0",
    "vite": "^4.4.0"
  }
}
