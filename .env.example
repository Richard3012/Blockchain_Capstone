PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/blockerp
MONGO_FALLBACK=true
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=12h

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
RECORD_ANCHOR_ADDRESS=

PINATA_API_KEY=
PINATA_JWT=
PINATA_GATEWAY=

VITE_API_URL=http://localhost:4000/api

# ── Google Cloud (Document AI / Vision / Vertex AI) ──────────
# Service-account JSON path (preferred). Generate in GCP Console.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
GCP_PROJECT_ID=
GCP_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Optional: image-only fallback when no service account is set
GOOGLE_VISION_API_KEY=

# ── Vertex AI / Gemini ───────────────────────────────────────
VERTEX_AI_MODEL=gemini-1.5-flash
VERTEX_AI_REEXTRACT_MODEL=gemini-1.5-pro

# ── Anthropic Claude (fallback for re-extract) ───────────────
ANTHROPIC_API_KEY=

# ── Privacy & cost guards ────────────────────────────────────
AI_REDACT_PII=false
AI_MAX_INPUT_CHARS=60000

# ── Background queue ─────────────────────────────────────────
OCR_QUEUE_CONCURRENCY=2
